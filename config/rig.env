# Exact physical identity and operating mode for this calibrated rig.
#
# LEFT/RIGHT are defined while looking forward from behind the camera rig.
# The ZED SDK 5.4 serial-pair path was observed to reverse these physical
# viewpoints. Live acquisition therefore uses the guarded fixed GMSL IDs below
# and uses virtual serial 117941018 for the 2026-10-14 calibration.
LEFT_SERIAL=306605936
LEFT_CAMERA_ID=1
LEFT_PORT=2
LEFT_I2C_PATH=/dev/i2c-10
RIGHT_SERIAL=304467158
RIGHT_CAMERA_ID=0
RIGHT_PORT=1
RIGHT_I2C_PATH=/dev/i2c-9
VIRTUAL_SERIAL=117941018
VIRTUAL_INPUT_MODE=camera_ids
WIDTH=1920
HEIGHT=1200
FPS=15
STREAM_PORT=34000
SQUARE_SIZE_MM=28.0
HORIZONTAL_INNER_CORNERS=9
VERTICAL_INNER_CORNERS=6
